{
  "name": "lossgraph",
  "version": "0.1.0",
  "description": "AI Risk Manager for Merchant Loss Intelligence",
  "private": true,
  "scripts": {
    "backend:install": "cd backend && pip install -r requirements.txt",
    "pipeline": "make pipeline",
    "backend:run": "cd backend && python -m uvicorn app.main:app --reload",
    "backend:test": "cd backend && pytest",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:test": "cd frontend && npm test",
    "setup": "npm run backend:install && npm run frontend:install",
    "dev": "concurrently \"npm run backend:run\" \"npm run frontend:dev\"",
    "test": "npm run backend:test && npm run frontend:test"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
