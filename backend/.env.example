# Environment variables (copy to .env and fill in)

# Database
DATABASE_URL=sqlite:///./lossgraph.db
# For PostgreSQL: postgresql://user:password@localhost:5432/lossgraph
SQL_ECHO=false

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
ENV=development

# Logging
LOG_LEVEL=INFO

# ML Model Configuration
MODEL_PATH=./models
ENABLE_GPU=false

# AI Investigator + Chargeback Responder drafts (ml/investigator.py,
# ml/chargeback_responder.py) -- optional. Get a free key with no credit
# card at https://aistudio.google.com/apikey. Without this set, `make
# pipeline` falls back to deterministic templates automatically (no error,
# this is the intended failure-handling path). Put the real value in a
# root-level .env (gitignored), not here.
GEMINI_API_KEY=...

# Frontend API URL (for frontend .env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
