# Environment variables (copy to .env and fill in)

# Database
DATABASE_URL=sqlite:///./lossgraph.db
# For PostgreSQL: postgresql://user:password@localhost:5432/lossgraph
SQL_ECHO=false

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
ENV=development

# Logging
LOG_LEVEL=INFO

# ML Model Configuration
MODEL_PATH=./models
ENABLE_GPU=false

# LLM Integration (optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Graph Database (optional)
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Frontend API URL (for frontend .env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
