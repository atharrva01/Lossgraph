# Environment variables (copy to .env and fill in)

# Database
DATABASE_URL=sqlite:///./lossgraph.db
# For PostgreSQL: postgresql://user:password@localhost:5432/lossgraph
SQL_ECHO=false

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
ENV=development

# Logging
LOG_LEVEL=INFO

# ML Model Configuration
MODEL_PATH=./models
ENABLE_GPU=false

# AI Investigator (ml/investigator.py) -- optional. Without this set,
# `make pipeline` falls back to deterministic evidence-chain narratives
# automatically (no error, this is the intended failure-handling path).
ANTHROPIC_API_KEY=sk-ant-...

# Frontend API URL (for frontend .env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
